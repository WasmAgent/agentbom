    "release:version": "changeset version",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  }
}
